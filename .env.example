# Anthropic Claude API Key (required for AI screening)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kaggle API credentials (optional)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Server config
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-string
JWT_EXPIRY=8h

# Data retention (days)
DATA_RETENTION_DAYS=120

# AI cost limit (USD per month)
AI_MONTHLY_LIMIT=5.00

# Mock mode - set to "true" to run without Claude API
MOCK_MODE=false
